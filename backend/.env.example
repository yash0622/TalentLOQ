# Talentloq Environment Variables Template (.env.example)
# IMPORTANT: Copy this file to .env and replace placeholder values. NEVER commit .env to source control!

# ---------------------------------------------------------------------------
# 1. MongoDB Database Configuration
# ---------------------------------------------------------------------------
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=talentloq_db

# ---------------------------------------------------------------------------
# 2. Authentication & Secrets
# ---------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_base64_secret_key_minimum_256_bits
RECRUITER_EMAIL=telentloqrecruiter@gmail.com
RECRUITER_INITIAL_PASSWORD=replace_with_strong_initial_recruiter_password
ADMIN_ALERT_EMAIL=admin@talentloq.com

# ---------------------------------------------------------------------------
# 3. Field-Level AES Encryption
# ---------------------------------------------------------------------------
# Generate via python: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
FIELD_ENCRYPTION_KEY=replace_with_fernet_url_safe_base64_encryption_key

# ---------------------------------------------------------------------------
# 4. Network Security & IP Restrictions
# ---------------------------------------------------------------------------
ENFORCE_RECRUITER_IP_RESTRICTION=false
ALLOWED_RECRUITER_IPS=127.0.0.1,::1,192.168.1.0/24

# ---------------------------------------------------------------------------
# 5. CORS Allowed Origins (Never '*' in Production!)
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://talentloq.app

# ---------------------------------------------------------------------------
# 6. External AI Services API Keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here
