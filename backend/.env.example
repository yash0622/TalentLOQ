# ===========================================================================
# TalentLOQ Environment Variables Template (.env.example)
# IMPORTANT: Copy this file to .env and replace placeholder values.
# NEVER commit your actual .env file to Git!
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. MongoDB Database Configuration
# ---------------------------------------------------------------------------
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=talentloq_db

# ---------------------------------------------------------------------------
# 2. Authentication & JWT Secrets
# ---------------------------------------------------------------------------
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace_with_a_secure_random_base64_secret_key_minimum_256_bits
RECRUITER_EMAIL=telentloqrecruiter@gmail.com
RECRUITER_INITIAL_PASSWORD=ChangeMeRecruiter2026!
ADMIN_ALERT_EMAIL=admin@talentloq.com
CAPTCHA_SECRET_KEY=replace_with_recaptcha_or_turnstile_secret_key

# ---------------------------------------------------------------------------
# 3. Field-Level AES PII Encryption
# ---------------------------------------------------------------------------
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace_with_fernet_url_safe_base64_encryption_key

# ---------------------------------------------------------------------------
# 4. SMTP / Email Dispatch Engine
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_google_app_password
SMTP_TLS=true
SMTP_FROM_EMAIL=no-reply@talentloq.com
# Set SHOW_DEV_OTP=false in production!
SHOW_DEV_OTP=true

# ---------------------------------------------------------------------------
# 5. Network Security & IP Restrictions
# ---------------------------------------------------------------------------
ENFORCE_RECRUITER_IP_RESTRICTION=false
ALLOWED_RECRUITER_IPS=127.0.0.1,::1,192.168.1.0/24

# ---------------------------------------------------------------------------
# 6. CORS Allowed Origins (Comma-separated)
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000,https://talentloq.app

# ---------------------------------------------------------------------------
# 7. External AI Services API Keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
